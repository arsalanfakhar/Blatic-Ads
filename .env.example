# Supabase (this project's own Supabase)
# Server-side
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key

# Client-side (NEXT_PUBLIC_ exposes to browser — publishable key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Database (Supabase Postgres)
# Pooled — app runtime (port 6543, transaction mode)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
# Direct — Prisma migrations only (port 5432, session mode)
DIRECT_URL=postgresql://postgres.xxx:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Meta Ads
META_ACCESS_TOKEN=your-meta-access-token
META_AD_ACCOUNT_IDS=act_123456,act_789012

# Shopify (primary order source)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your-shopify-admin-api-token

# Atlas (optional — Blatic internal only, for enriched order data)
ATLAS_SUPABASE_URL=https://atlas-project.supabase.co
ATLAS_SUPABASE_SERVICE_KEY=atlas-service-role-key

# Cron security
CRON_SECRET=your-cron-secret
